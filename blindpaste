#!/usr/bin/env bash
# blindpaste - decode the ciphertext on the clipboard into plaintext, in place,
# without the plaintext ever being shown on screen.
#
# The plaintext may only flow through pipes: into pbcopy, and into shasum to
# become a hash. It never appears on stdout, in argv, in a file, or in any
# command-line argument.
#
# SPDX-License-Identifier: MIT
set -uo pipefail

die() { printf 'blindpaste: %s\n' "$1" >&2; exit "${2:-1}"; }

# Self-contained: the key defaults to the directory this script really lives
# in, never to $HOME or any system location. Symlinks are resolved, so a
# symlink on PATH still points at the repo (and its .gitignore).
# BASH_SOURCE rather than $0 so this is also right when sourced with
# BLINDPASTE_LIB=1. Builtins only (readlink is needed only for a symlink), so
# this works even with a bare PATH. CDPATH is cleared so `cd` cannot jump
# elsewhere or print anything.
# bp_parent <path> -> sets the caller's local $dir to the parent of <path>.
bp_parent() { case $1 in */*) dir=${1%/*}; dir=${dir:-/} ;; *) dir=. ;; esac; }
bp_resolve_dir() {
  local src=${BASH_SOURCE[0]} dir
  while [ -L "$src" ]; do
    bp_parent "$src"
    dir=$(CDPATH= cd -P -- "$dir" && pwd) || return 1
    src=$(readlink "$src") || return 1
    case $src in /*) ;; *) src=$dir/$src ;; esac
  done
  bp_parent "$src"
  CDPATH= cd -P -- "$dir" && pwd
}

BP_DIR=$(bp_resolve_dir) || die 'cannot resolve the script directory'
BP_KEY="${BLINDPASTE_KEY:-$BP_DIR/.blindpaste.key}"
BP_DEFAULT_TTL=90

usage() {
  cat <<'EOF'
Usage:
  blindpaste [-t SECONDS]     decode the ciphertext on the clipboard, put the plaintext back
  blindpaste - [-t SECONDS]   read the ciphertext from stdin instead
  blindpaste --sender         print the commands to forward to the sender
  blindpaste --init           generate an age keypair
  -t 0                        do not auto-clear the clipboard (default: clear after 90s)

Exit codes: 0 ok, 1 usage error, 2 unrecognized format, 3 missing dependency,
            4 decode failed, 5 empty input
EOF
}

# sniff <blob> -> age | b64 | none
sniff() {
  local blob=$1 compact
  case $blob in
    *'BEGIN AGE ENCRYPTED FILE'*) printf age; return 0 ;;
  esac
  compact=$(printf %s "$blob" | tr -d '[:space:]')
  if [ -n "$compact" ] && printf %s "$compact" | grep -qE '^[A-Za-z0-9+/]+={0,2}$'; then
    printf b64
  else
    printf none
  fi
}

# hash_of <string> -> first 16 hex digits of its SHA-256
hash_of() { printf %s "$1" | shasum -a 256 | cut -c1-16; }

# describe <plain> -> e.g. "6 chars, digits only". Shape only, never content.
describe() {
  local p=$1 kind
  case $p in
    *[!A-Za-z0-9]*) kind='has symbols' ;;
    *[A-Za-z]*)     kind='has letters' ;;
    *)              kind='digits only' ;;
  esac
  printf '%d chars, %s' "${#p}" "$kind"
}

# is_printable_ascii <s> -> success iff every byte is in 0x20-0x7E.
# Byte-level on purpose: grep is line-based and would let an embedded newline
# through, and a bash pattern depends on the locale. An explicit octal range
# under LC_ALL=C is exactly 0x20-0x7E on any tr, with no dependence on how a
# character class is defined. Counting with wc -c (rather than testing the
# output of a command substitution) keeps a lone newline from being stripped.
is_printable_ascii() {
  local n
  n=$(printf %s "$1" | LC_ALL=C tr -d '\040-\176' | wc -c | tr -d ' ')
  [ "$n" -eq 0 ]
}

# decode <mode> <blob> -> plaintext on stdout. 3 = key not readable, 4 = unknown mode
decode() {
  local mode=$1 blob=$2
  case $mode in
    b64) printf %s "$blob" | tr -d '[:space:]' | base64 -D 2>/dev/null ;;
    age) [ -r "$BP_KEY" ] || return 3
         printf %s "$blob" | age -d -i "$BP_KEY" 2>/dev/null ;;
    *)   return 4 ;;
  esac
}

# clear_if_unchanged <hash> <ttl>
# After ttl seconds, clear the clipboard only if it still holds what we wrote.
# The guard exists so we never wipe something the user copied in the meantime.
# Fails closed: an empty or malformed hash (e.g. shasum failed) never matches,
# otherwise "" = "" would wipe whatever is on the clipboard.
clear_if_unchanged() {
  local want=$1 ttl=$2 have
  case $want in ''|*[!0-9a-f]*) return 0 ;; esac
  [ "$ttl" -gt 0 ] && sleep "$ttl"
  have=$(hash_of "$(pbpaste)")
  if [ "$have" = "$want" ]; then
    printf '' | pbcopy
  fi
  return 0
}

# schedule_clear <hash> <ttl>
# Run clear_if_unchanged in a background subshell that ignores SIGHUP, so it
# survives the terminal being closed (the same thing nohup does). A subshell,
# not a re-exec of "$0", for two reasons:
#  - The hash then lives only in this process's memory and never appears in
#    argv. Any local user can read argv with `ps`, and endpoint/audit software
#    often logs it. For a low-entropy secret such as a 6-digit code the hash is
#    as good as the plaintext: all 10^6 candidates take well under a second.
#  - It does not depend on how the script was invoked. With `bash blindpaste`,
#    "$0" is a bare name that nohup would look up on PATH and not find.
schedule_clear() {
  local want=$1 ttl=$2
  ( trap '' HUP; clear_if_unchanged "$want" "$ttl" ) </dev/null >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

init_key() {
  command -v age-keygen >/dev/null 2>&1 || die 'age is not installed (macOS: brew install age)' 3
  [ -e "$BP_KEY" ] && die "key already exists: $BP_KEY (not overwriting)" 1
  # Only create the directory, and tighten its permissions, if it does not
  # exist yet. The default key lives in the repo root, and chmod 700 on an
  # existing directory would change the permissions of the repo itself.
  local dir; bp_parent "$BP_KEY"
  if [ ! -d "$dir" ]; then
    mkdir -p "$dir" || die "cannot create $dir"
    chmod 700 "$dir"
  fi
  ( umask 077; age-keygen -o "$BP_KEY" >/dev/null 2>&1 ) || die 'age-keygen failed' 3
  chmod 600 "$BP_KEY"
  printf 'key created: %s\npublic key (run blindpaste --sender for the full command to forward):\n' "$BP_KEY" >&2
  grep -o 'age1[a-z0-9]*' "$BP_KEY" | head -1
}

# Always print the base64 command; add the age command when a key exists.
# Whether I have a key and whether the sender has age installed are
# independent, and the script cannot know the latter.
#
# In the sender commands:
#  - `IFS= read -rs` reads without echo, keeps backslashes (-r) and keeps
#    leading/trailing spaces (IFS=). The secret never enters shell history.
#  - `echo >&2` ends the prompt line. read -s swallows the Enter key, so
#    without it the ciphertext lands right after "secret: " on the same line,
#    and copying from the start of the line breaks decoding.
sender_cmds() {
  cat <<'EOF'
# Forward one of these to the sender. Neither writes the secret to their
# shell history, and neither needs pbcopy (they may be on Linux or WSL).

# base64 (nothing to install; obfuscation only, NOT encryption):
printf 'secret: ' >&2; IFS= read -rs s; echo >&2; printf %s "$s" | base64 | tr -d '\n'; echo; unset s
EOF
  if [ -r "$BP_KEY" ]; then
    local pub; pub=$(grep -o 'age1[a-z0-9]*' "$BP_KEY" | head -1)
    printf '\n# age (sender needs age installed; real encryption, recommended):\n'
    printf "printf 'secret: ' >&2; IFS= read -rs s; echo >&2; printf %%s \"\$s\" | age -a -r %s; unset s\n" "$pub"
  else
    printf '\n# age command unavailable: no key yet. Run: blindpaste --init\n'
  fi
}

main() {
  local ttl=$BP_DEFAULT_TTL src=clipboard blob mode plain rc h

  case ${1:-} in
    --init)    init_key; return $? ;;
    --sender)  sender_cmds; return 0 ;;
    -h|--help) usage; return 0 ;;
  esac

  while [ $# -gt 0 ]; do
    case $1 in
      -t) [ $# -ge 2 ] || die '-t needs an argument'
          case $2 in ''|*[!0-9]*) die "-t needs a non-negative integer: $2" ;; esac
          ttl=$2; shift 2 ;;
      -)  src=stdin; shift ;;
      *)  die "unknown argument: $1" ;;
    esac
  done

  # pbcopy/pbpaste only exist on macOS. Fail clearly instead of half-working.
  if ! command -v pbcopy >/dev/null 2>&1 || ! command -v pbpaste >/dev/null 2>&1; then
    die 'pbcopy/pbpaste not found: blindpaste only runs on macOS' 3
  fi

  if [ "$src" = stdin ]; then blob=$(cat); else blob=$(pbpaste); fi
  [ -n "$blob" ] || die 'input is empty' 5

  mode=$(sniff "$blob")
  [ "$mode" != none ] || die 'unrecognized format: neither age armor nor base64. Clipboard unchanged' 2

  if [ "$mode" = age ] && ! command -v age >/dev/null 2>&1; then
    die 'this is age ciphertext, but age is not installed (macOS: brew install age)' 3
  fi

  # Command substitution silently drops NUL bytes, which would let a result
  # containing NULs through altered. Map NUL to 0x01 first so the
  # printable-ASCII check below rejects it. pipefail keeps decode's status.
  plain=$(decode "$mode" "$blob" | LC_ALL=C tr '\000' '\001'); rc=$?
  case $rc in
    0) ;;
    3) die "no readable private key: $BP_KEY. Run: blindpaste --init" 3 ;;
    *) die "decode failed ($mode). Clipboard unchanged" 4 ;;
  esac
  [ -n "$plain" ] || die 'decoded result is empty. Clipboard unchanged' 4
  # sniff cannot tell real base64 from, say, a string of digits whose length
  # happens to be a multiple of 4; decoding the latter yields garbage bytes.
  # This check turns that case into a clean exit 4 instead of putting garbage
  # on the clipboard. Garbage is usually high bytes (0x80-0xFF), which are not
  # control characters, so test for "not printable ASCII", not "control".
  if ! is_printable_ascii "$plain"; then
    die 'decoded result is not single-line printable ASCII (non-ASCII secrets are not supported); probably not ciphertext meant for you. Clipboard unchanged' 4
  fi

  printf %s "$plain" | pbcopy
  printf 'ok  %s -> clipboard ready (%s)\n' "$mode" "$(describe "$plain")" >&2

  if [ "$ttl" -gt 0 ]; then
    h=$(hash_of "$plain")
    if [ ${#h} -ne 16 ]; then
      printf '    warning: cannot hash the clipboard (is shasum installed?); auto-clear disabled\n' >&2
      return 0
    fi
    # Do not carry the secret into the long-lived background process. Best
    # effort: bash cannot scrub freed memory.
    unset plain blob
    schedule_clear "$h" "$ttl"
    # %s, not %d: printf would read a leading zero (-t 08) as octal.
    printf '    auto-clear in %ss (only if the clipboard is still unchanged)\n' "$ttl" >&2
  fi
}

if [ "${BLINDPASTE_LIB:-}" != 1 ]; then
  main "$@"
fi
